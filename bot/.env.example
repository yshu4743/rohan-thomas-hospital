# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────
# App dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# App dashboard → App settings → Basic. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# Any random string you invent. Paste the same value into the webhook setup.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string

# ── Staff handoff ────────────────────────────────────────────────────────
# Comma separated staff numbers in international format, digits only:
# 919876543210,919876543211
STAFF_WHATSAPP_NUMBERS=

# Optional: your shared inbox / CRM / n8n / Google Sheet webhook. We POST JSON.
STAFF_INBOX_WEBHOOK=

# How many minutes the bot stays silent after a handoff (staff can resume sooner
# by replying from the admin API).
HANDOFF_PAUSE_MINUTES=120

# ── Admin ────────────────────────────────────────────────────────────────
# Long random string. Required for every /admin call.
ADMIN_KEY=

# Default supplier for hospital stock orders.
STOCK_SUPPLIER=Leo Pharma, Thrissur

# ── Runtime ──────────────────────────────────────────────────────────────
PORT=3000
HOSPITAL_NAME=Rohan Thomas Hospital
TZ=Asia/Kolkata

# Log outbound messages instead of sending them. Useful before the Meta
# credentials are live. Never set this in production.
BOT_DRY_RUN=false
